# Anthropic API key, used to personalize the thank-you email copy.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend API key, used to actually send emails (thank-you + owner alerts).
# Get one at https://resend.com/ (free tier is enough to start).
RESEND_API_KEY=

# The "From" address emails are sent from. Must be on a domain you've
# verified in Resend before this will deliver.
EMAIL_FROM="Automatyzacja Opinii <opinie@twoja-domena.pl>"

# Postgres connection string. Any host works — Neon and Supabase both have
# a free tier that's plenty for this. Run db/schema.sql against it once.
DATABASE_URL=

# Upstash Redis, used only to rate-limit /api/feedback. Free tier at
# https://upstash.com/. Leave blank to skip rate limiting in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the /admin dashboard (Basic Auth, any username works).
# Pick a real secret before deploying — the admin panel is fully disabled
# until this is set.
ADMIN_PASSWORD=
